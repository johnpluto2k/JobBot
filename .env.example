# Copy to .env and fill in. Phase 1 runs WITHOUT a key (heuristic extractor),
# but setting one upgrades extraction quality via the Claude API.

ANTHROPIC_API_KEY= sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cheap/fast model for mechanical calls (resume bullet rewriting):
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Optional overrides (defaults shown):
# JOB_BOT_DOCS_DIR=./Professional Development
# JOB_BOT_OUTPUT_DIR=./data

# jobright.ai import (job_bot/jobright.py) — cookie path. Export your logged-in
# jobright session cookie from the browser (DevTools ▸ Application ▸ Cookies, or
# the Copy-as-cURL cookie header) and paste it here. Personal use; expires, so
# re-export periodically. Leave blank to use the Playwright path instead.
# JOBRIGHT_COOKIE=
