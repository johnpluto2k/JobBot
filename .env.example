# Copy to .env and fill in. Phase 1 runs WITHOUT a key (heuristic extractor),
# but setting one upgrades extraction quality via the Claude API.

ANTHROPIC_API_KEY= sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cheap/fast model for mechanical calls (resume bullet rewriting):
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Optional overrides (defaults shown):
# JOB_BOT_DOCS_DIR=./Professional Development
# JOB_BOT_OUTPUT_DIR=./data

# Google login + Gmail sync (job_bot/google_auth.py, job_bot/gmail_client.py).
# Create an OAuth 2.0 "Web application" client in Google Cloud Console with
# http://localhost:8000/auth/callback as an authorized redirect URI, and enable
# the Gmail API for the project. Scopes used: openid, email, profile,
# gmail.readonly (read-only — the app never sends or modifies mail).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional Gmail sync tuning (defaults shown):
# GMAIL_SYNC_DAYS=7            # how far back each sync looks
# GMAIL_SYNC_MAX_THREADS=50    # per-sync thread cap
# GMAIL_SYNC_QUERY=            # override the job-keyword Gmail search query

# jobright.ai import (job_bot/jobright.py) — cookie path. Export your logged-in
# jobright session cookie from the browser (DevTools ▸ Application ▸ Cookies, or
# the Copy-as-cURL cookie header) and paste it here. Personal use; expires, so
# re-export periodically. Leave blank to use the Playwright path instead.
# JOBRIGHT_COOKIE=
