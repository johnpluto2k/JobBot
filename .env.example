# Copy to .env and fill in what you have. Everything is optional: the pipeline
# runs with no keys at all (heuristic extraction, template letters, no sign-in).

# --- Anthropic ---------------------------------------------------------------
# Unlocks LLM profile extraction, JD-aware bullet rewrites, cover letters, the
# mock interviewer, and the dashboard Coach tab.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cheap/fast model for mechanical calls (resume bullet rewriting):
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# --- Google sign-in + read-only Gmail sync -----------------------------------
# job_bot/google_auth.py, job_bot/gmail_client.py. Create an OAuth 2.0 "Web
# application" client in Google Cloud Console with
# http://localhost:8000/auth/callback as an authorized redirect URI and enable
# the Gmail API. Scopes: openid, email, profile, gmail.readonly. The app never
# sends, labels, or deletes mail. See docs/SETUP.md section 3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional Gmail sync tuning (defaults shown):
# GMAIL_SYNC_DAYS=7            # how far back each sync looks
# GMAIL_SYNC_MAX_THREADS=50    # per-sync thread cap
# GMAIL_SYNC_QUERY=            # override the job-keyword Gmail search query

# --- Who you are (normally read from data/master_profile.json) ---------------
# Fallbacks used in prompts and letters before a profile exists. Once
# build_profile has run, the profile wins.
# JOB_BOT_CANDIDATE_NAME=Ada Lovelace
# JOB_BOT_CANDIDATE_BLURB=a Computer Science student at Example University (graduating May 2027)

# --- Where home is (watcher location filter) ---------------------------------
# Comma-separated city/state words that count as "home". Remote and nationwide
# postings always pass. Default: the DC-Maryland-Virginia area.
# JOB_BOT_HOME_MARKERS=chicago,il,illinois,evanston,naperville

# --- Alerts ------------------------------------------------------------------
# Slack-compatible incoming webhook for watcher finds, deadlines, follow-ups.
# JOB_BOT_WEBHOOK=https://hooks.slack.com/services/...

# --- Paths (defaults shown) --------------------------------------------------
# JOB_BOT_DOCS_DIR=./documents/Professional Development
# JOB_BOT_TRANSCRIPT_DIR=./documents/School Related Stuff
# JOB_BOT_OUTPUT_DIR=./data
